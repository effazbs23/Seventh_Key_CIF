<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Cron job to cleanup expired Email OTPs -->
        <record id="ir_cron_cleanup_expired_email_otps" model="ir.cron">
            <field name="name">Cleanup Expired Email OTPs</field>
            <field name="model_id" ref="model_email_otp"/>
            <field name="state">code</field>
            <field name="code">model.cleanup_expired_otps()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="True"/>
            <field name="user_id" ref="base.user_root"/>
        </record>
    </data>
</odoo>

