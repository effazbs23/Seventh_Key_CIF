<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- CIF Form Security -->
        <record id="cif_form_rule" model="ir.rule">
            <field name="name">CIF Form: Multi-company</field>
            <field name="model_id" ref="model_cif_form"/>
            <field name="domain_force">['|', ('source_sale_order_id.company_id', '=', False), ('source_sale_order_id.company_id', 'in', company_ids)]</field>
        </record>

        <!-- CIF Change Request Security -->
        <record id="cif_change_request_rule" model="ir.rule">
            <field name="name">CIF Change Request: Multi-company</field>
            <field name="model_id" ref="model_cif_change_request"/>
            <field name="domain_force">['|', ('sale_order_id.company_id', '=', False), ('sale_order_id.company_id', 'in', company_ids)]</field>
        </record>

        <!-- CIF Request Session Security -->
        <record id="cif_request_session_rule" model="ir.rule">
            <field name="name">CIF Request Session: Multi-company</field>
            <field name="model_id" ref="model_cif_request_session"/>
            <field name="domain_force">['|', ('sale_order_id.company_id', '=', False), ('sale_order_id.company_id', 'in', company_ids)]</field>
        </record>
    </data>
</odoo>
