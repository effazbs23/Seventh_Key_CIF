<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_cif_form_reject_reason_wizard_form" model="ir.ui.view">
        <field name="name">cif.form.reject.reason.wizard.form</field>
        <field name="model">cif.form.reject.reason.wizard</field>
        <field name="arch" type="xml">
            <form string="Reject CIF">
                <group>
                    <field name="cif_form_id" invisible="1"/>
                    <field name="reason" placeholder="Enter rejection reason..."/>
                </group>
                <footer>
                    <button name="action_confirm_reject" type="object" string="Reject" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
