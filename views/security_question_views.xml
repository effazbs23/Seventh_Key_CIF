<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="view_security_question_list" model="ir.ui.view">
        <field name="name">security.question.list</field>
        <field name="model">security.question</field>
        <field name="arch" type="xml">
            <list>
                <field name="question"/>
                <field name="ans_max_length"/>
            </list>
        </field>
    </record>

    <record id="view_security_question_form" model="ir.ui.view">
        <field name="name">security.question.form</field>
        <field name="model">security.question</field>
        <field name="arch" type="xml">
            <form string="Security Question">
                <group>
                    <field name="question"/>
                    <field name="ans_max_length"/>
                </group>
            </form>
        </field>
    </record>

    <record id="action_security_questions" model="ir.actions.act_window">
        <field name="name">Security Questions</field>
        <field name="res_model">security.question</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create security questions.</p>
        </field>
    </record>

    <menuitem id="menu_questions_config" name="Question's Config" parent="sale.menu_sale_config" sequence="90"/>

    <menuitem id="menu_security_questions" name="Security Questions" parent="menu_questions_config" action="action_security_questions" sequence="1"/>
</odoo>
