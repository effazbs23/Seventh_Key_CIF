<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Base list view for sale.order.purchaser -->
        <record id="view_sale_order_purchaser_list" model="ir.ui.view">
            <field name="name">sale.order.purchaser.list</field>
            <field name="model">sale.order.purchaser</field>
            <field name="arch" type="xml">
                <list>
                    <field name="sequence" widget="handle"/>
                    <field name="partner_id"/>
                    <field name="partner_email" optional="hide"/>
                    <field name="partner_mobile" optional="hide"/>
                    <field name="partner_passport_no" optional="hide"/>
                    <field name="partner_nationality_id" optional="hide"/>
                    <field name="share_percentage"/>
                    <field name="is_representative" widget="boolean" optional="hide"/>
                    <field name="eoi_signed" widget="boolean" optional="hide"/>
                    <field name="cif_form_id" optional="hide"/>
                </list>
            </field>
        </record>

        <!-- Base form view for sale.order.purchaser -->
        <record id="view_sale_order_purchaser_form" model="ir.ui.view">
            <field name="name">sale.order.purchaser.form</field>
            <field name="model">sale.order.purchaser</field>
            <field name="arch" type="xml">
                <form string="Purchaser">
                    <sheet>
                        <group>
                            <group>
                                <field name="partner_id"/>
                                <field name="partner_email" readonly="1"/>
                                <field name="partner_mobile" readonly="1"/>
                                <field name="partner_passport_no" readonly="1"/>
                                <field name="partner_nationality_id" readonly="1"/>
                                <field name="partner_contact_address" readonly="1"/>
                                <field name="share_percentage" required="1"/>
                            </group>
                            <group>
                                <field name="sale_order_id"/>
                                <field name="is_representative" readonly="1"/>
                                <field name="eoi_signed" readonly="1"/>
                                <field name="cif_form_id" readonly="1"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Action window -->
        <record id="action_sale_order_purchaser" model="ir.actions.act_window">
            <field name="name">Purchasers</field>
            <field name="res_model">sale.order.purchaser</field>
            <field name="view_mode">list,form</field>
        </record>
    </data>
</odoo>
